
{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} | PHP2Symfony AI{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container">
        <div class="mb-4">
            <span class="section-label">MIGRATION WORKSPACE</span>
            <h1 class="mt-2">{{ project.name }}</h1>
            <p class="text-secondary">
                {{ project.sourceFramework }} → {{ project.targetFramework }}
            </p>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="feature-card">
            <h2 class="h5 mb-3">Upload your legacy application</h2>

            <p class="text-secondary">
                Upload a ZIP archive containing your PHP source code
                to begin the migration analysis.
            </p>

            {% if project.archiveFilename %}
                <p class="text-success">
                    Uploaded: {{ project.archiveFilename }}
                </p>
            {% endif %}

            {{ form_start(uploadForm) }}
                <div class="mb-3">
                    {{ form_row(uploadForm.archive, {
                        label_attr: { class: 'mb-2' },
                        attr: { class: 'form-control' }
                    }) }}
                </div>

                <button type="submit" class="btn btn-primary btn-sm px-3 py-2 mt-3">
                    Upload ZIP
                </button>
            {{ form_end(uploadForm) }}

            {% if project.archiveFilename %}
                <div class="mt-4">
                    <form method="post" action="{{ path('app_project_extract', {id: project.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('extract' ~ project.id) }}">

                        <button type="submit" class="btn btn-outline-info btn-sm px-3 py-2">
                            Extract Files
                        </button>
                    </form>
                </div>
            {% endif %}

            {% if analysis is not null %}
                <div class="feature-card mt-4">
                    <h2 class="h5 mb-3">PHP Analysis</h2>

                    <p class="text-secondary">
                        Found {{ analysis.totalFiles }} PHP files.
                    </p>

                    {% if analysis.totalFiles > 0 %}
                        <div class="table-responsive">
                            <table class="table table-dark table-striped align-middle">
                                <thead>
                                    <tr>
                                        <th>File</th>
                                        <th>Size</th>
                                        <th>Lines</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for file in analysis.files %}
                                        <tr>
                                            <td>{{ file.path }}</td>
                                            <td>{{ file.size }} bytes</td>
                                            <td>{{ file.lines }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            {% endif %}

        </div>
    </div>
</section>
{% endblock %}
