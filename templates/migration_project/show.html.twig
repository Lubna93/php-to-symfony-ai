
{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} | PHP2Symfony AI{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container">

        <div class="mb-4">
            <span class="section-label">MIGRATION WORKSPACE</span>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-2">
                <div>
                    <h1 class="mb-2">{{ project.name }}</h1>
                    <p class="text-secondary mb-0">
                        {{ project.sourceFramework }} → {{ project.targetFramework }}
                    </p>
                </div>

                <span class="badge rounded-pill text-bg-secondary px-3 py-2">
                    {{ project.status.value|replace({'_': ' '})|title }}
                </span>
            </div>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {# Upload #}
        <div class="feature-card mb-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <span class="step-number">01</span>
                <div>
                    <h2 class="h5 mb-1">Upload legacy application</h2>
                    <p class="text-secondary small mb-0">
                        Upload your PHP source code as a ZIP archive.
                    </p>
                </div>
            </div>

            {% if project.archiveFilename %}
                <div class="d-flex align-items-center gap-3 p-3 rounded border mb-4">
                    <span class="badge text-bg-secondary">ZIP</span>

                    <div class="flex-grow-1 text-truncate">
                        {{ project.archiveFilename }}
                    </div>

                    <span class="text-success">✓</span>
                </div>
            {% endif %}

            {{ form_start(uploadForm) }}
                {{ form_row(uploadForm.archive, {
                    label_attr: { class: 'mb-2' },
                    attr: { class: 'form-control' }
                }) }}

                <button type="submit" class="btn btn-primary btn-sm px-3 py-2 mt-3">
                    Upload ZIP
                </button>
            {{ form_end(uploadForm) }}

            {% if project.archiveFilename %}
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 border-top pt-4 mt-4">
                    <div>
                        <h3 class="h6 mb-1">Ready for extraction</h3>
                        <p class="text-secondary small mb-0">
                            Extract the archive to prepare the PHP analysis.
                        </p>
                    </div>

                    <form method="post"
                          action="{{ path('app_project_extract', {uid: project.uid}) }}">
                        <input type="hidden"
                               name="_token"
                               value="{{ csrf_token('extract' ~ project.id) }}">

                        <button type="submit" class="btn btn-outline-info btn-sm px-3 py-2">
                            Extract Files
                        </button>
                    </form>
                </div>
            {% endif %}
        </div>

        {% if analysis is not null %}

            {# PHP Analysis #}
            <div class="feature-card mb-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="step-number">02</span>
                    <div>
                        <h2 class="h5 mb-1">PHP Code Analysis</h2>
                        <p class="text-secondary small mb-0">
                            Structural overview of your legacy application.
                        </p>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="stat-card rounded p-3 h-100">
                            <div class="text-secondary small mb-2">PHP Files</div>
                            <div class="fs-2 fw-bold">{{ analysis.totalFiles }}</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="stat-card rounded p-3 h-100">
                            <div class="text-secondary small mb-2">
                                Classes / Interfaces / Traits
                            </div>
                            <div class="fs-2 fw-bold">{{ analysis.totalClasses }}</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="stat-card rounded p-3 h-100">
                            <div class="text-secondary small mb-2">
                                Functions / Methods
                            </div>
                            <div class="fs-2 fw-bold">{{ analysis.totalFunctions }}</div>
                        </div>
                    </div>
                </div>

                {% if analysis.totalFiles > 0 %}
                    <div class="text-end mt-4">
                        <button type="button"
                                class="btn btn-outline-info btn-sm px-3 py-2"
                                data-bs-toggle="modal"
                                data-bs-target="#phpFilesModal">
                            View PHP Files
                            <span class="badge text-bg-secondary ms-2">
                                {{ analysis.totalFiles }}
                            </span>
                        </button>
                    </div>
                {% endif %}
            </div>

            {# AI Migration Plan #}
            <div class="feature-card mb-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="step-number">03</span>
                    <div>
                        <h2 class="h5 mb-1">AI Migration Plan</h2>
                        <p class="text-secondary small mb-0">
                            Generate a Symfony migration strategy based on the PHP analysis.
                        </p>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-3 p-3 rounded border">
                    <span class="fs-3 accent-text">✦</span>

                    <div class="flex-grow-1">
                        <div class="fw-semibold">Symfony Migration Architect</div>
                        <div class="text-secondary small">
                            AI-powered migration recommendations.
                        </div>
                    </div>

                    <form method="post"
                          action="{{ path('app_project_generate_plan', {uid: project.uid}) }}">
                        <input type="hidden"
                               name="_token"
                               value="{{ csrf_token('generate-plan' ~ project.id) }}">

                        <button type="submit" class="btn btn-primary btn-sm px-3 py-2">
                            {{ migrationPlan ? 'Regenerate Plan' : 'Generate Plan' }}
                        </button>
                    </form>
                </div>

                {% if migrationPlan %}
                    <div class="border rounded mt-4">
                        <div class="d-flex justify-content-between align-items-center gap-2 p-3 border-bottom">
                            <h3 class="h6 mb-0">Generated Migration Plan</h3>
                            <span class="badge text-bg-secondary">AI Generated</span>
                        </div>

                        <div class="migration-plan-content p-4">
                            {{ migrationPlanHtml|raw }}
                        </div>
                    </div>
                {% endif %}
            </div>

        {% endif %}
    </div>
</section>

{# PHP Files Modal #}
{% if analysis is not null and analysis.totalFiles > 0 %}
    <div class="modal fade"
         id="phpFilesModal"
         tabindex="-1"
         aria-labelledby="phpFilesModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content bg-dark text-light border-secondary">

                <div class="modal-header border-secondary">
                    <div>
                        <span class="section-label">SOURCE CODE</span>
                        <h2 class="modal-title fs-5 mt-1" id="phpFilesModalLabel">
                            PHP Files ({{ analysis.totalFiles }})
                        </h2>
                    </div>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">File Path</th>
                                    <th>Size</th>
                                    <th>Lines</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for file in analysis.files %}
                                    <tr>
                                        <td class="ps-4 font-monospace small">
                                            {{ file.path }}
                                        </td>
                                        <td>{{ file.size|number_format(0, '.', ' ') }} B</td>
                                        <td>{{ file.lines }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="modal-footer border-secondary">
                    <button type="button"
                            class="btn btn-outline-light btn-sm"
                            data-bs-dismiss="modal">
                        Close
                    </button>
                </div>

            </div>
        </div>
    </div>
{% endif %}
{% endblock %}
