{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} | PHP2Symfony AI{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container">

        {{ include('migration_project/_components/_project_header.html.twig') }}
        
        {{ include('migration_project/_components/_framework_info.html.twig') }}
        
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {{ include('migration_project/_components/_upload_card.html.twig') }}

        {% if analysis is not null %}
            {{ include('migration_project/_components/_analysis_card.html.twig') }}
            {{ include('migration_project/_components/_migration_plan_card.html.twig') }}
        {% endif %}

    </div>
</section>

{% if analysis is not null and analysis.totalFiles > 0 %}
    {{ include('migration_project/_components/_file_details_modal.html.twig') }}
    {{ include('migration_project/_components/_dependency_modal.html.twig') }}
    {{ include('migration_project/_components/_code_migration_modal.html.twig') }}
{% endif %}
{% endblock %}