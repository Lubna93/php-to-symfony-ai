<div class="modal fade"
     id="codeMigrationModal"
     data-controller="code-migration"
     tabindex="-1"
     aria-labelledby="codeMigrationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content bg-dark text-light border-secondary">

            <div class="modal-header border-secondary">
                <div>
                    <span class="section-label">AI CODE MIGRATION</span>
                    <h2 class="modal-title fs-5 mt-1" id="codeMigrationModalLabel">
                        Symfony Migration
                    </h2>
                    <div class="small text-secondary font-monospace"
                         id="migrationFileName"></div>
                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div id="migrationLoading" class="text-center py-5 d-none">
                    <div class="spinner-border text-warning mb-3" role="status"></div>
                    <p class="text-secondary mb-0">
                        Generating Symfony migration...
                    </p>
                </div>

                <div id="migrationError"
                     class="alert alert-danger d-none"
                     role="alert"></div>

                <div id="migrationResult" class="row g-3 d-none">
                    <div class="col-lg-6">
                        <h3 class="fs-6 mb-2">Original PHP</h3>
                        <button
                            type="button"
                            class="btn border-0 bg-transparent p-0 mb-2 text-secondary"
                            data-action="click->code-migration#copy"
                            data-code-migration-target-param="originalPhpCode"
                            title="Copy"
                            aria-label="Copy to clipboard"
                        >
                            <svg width="24" height="24" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round"
                                aria-hidden="true">
                                <rect x="8" y="8" width="12" height="12" rx="2"/>
                                <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>
                            </svg>
                        </button>
                        <pre class="bg-black border border-secondary rounded p-3 overflow-auto"
                             style="max-height: 65vh;"><code id="originalPhpCode"></code></pre>
                    </div>

                    <div class="col-lg-6">
                        <h3 class="fs-6 mb-2">AI Migration Proposal</h3>
                        <button
                            type="button"
                            class="btn border-0 bg-transparent p-0 mb-2 text-secondary"
                            data-action="click->code-migration#copy"
                            data-code-migration-target-param="generatedSymfonyCode"
                            title="Copy"
                            aria-label="Copy to clipboard"
                        >
                            <svg width="24" height="24" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round"
                                aria-hidden="true">
                                <rect x="8" y="8" width="12" height="12" rx="2"/>
                                <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>
                            </svg>
                        </button>
                        <div id="generatedSymfonyCode"
                            class="migration-markdown bg-black border border-secondary rounded p-3 overflow-auto"
                            style="max-height: 65vh;">
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-secondary">
                <button type="button"
                        class="btn btn-outline-light btn-sm"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>