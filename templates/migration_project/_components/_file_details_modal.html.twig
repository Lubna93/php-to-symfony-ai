<div class="modal fade"
     id="phpFilesModal"
     tabindex="-1"
     aria-labelledby="phpFilesModalLabel"
     aria-hidden="true"
     data-controller="code-migration"
     data-code-migration-url-value="{{ path('app_project_migrate_code', { uid: project.uid }) }}"
     data-code-migration-token-value="{{ csrf_token('migrate-code' ~ project.id) }}">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content bg-dark text-light border-secondary">

            <div class="modal-header border-secondary">
                <div>
                    <span class="section-label">SOURCE CODE</span>
                    <h2 class="modal-title fs-5 mt-1" id="phpFilesModalLabel">
                        PHP Files ({{ analysis.totalFiles }})
                    </h2>
                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">File Path</th>
                                <th>Size</th>
                                <th>Lines</th>
                                <th>DB Calls</th>
                                <th>Legacy Calls</th>
                                <th>Review Priority</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            {% for file in analysis.files %}
                                <tr>
                                    <td class="ps-4 font-monospace small">
                                        {{ file.path }}
                                    </td>

                                    <td>
                                        {{ file.size|number_format(0, '.', ' ') }} B
                                    </td>

                                    <td>{{ file.lines }}</td>

                                    <td>{{ file.databaseCalls|length }}</td>

                                    <td>
                                        {% if file.legacyCalls|length > 0 %}
                                            <span class="badge text-bg-warning">
                                                {{ file.legacyCalls|length }}
                                            </span>
                                        {% else %}
                                            0
                                        {% endif %}
                                    </td>

                                    <td>
                                        <span class="badge text-bg-{{
                                            file.priority == 'High' ? 'danger' :
                                            (file.priority == 'Medium' ? 'warning' : 'secondary')
                                        }}">
                                            {{ file.priority }}
                                        </span>
                                    </td>

                                    <td>
                                        <button type="button"
                                                class="btn btn-outline-warning btn-sm"
                                                data-action="click->code-migration#migrate"
                                                data-code-migration-file-param="{{ file.path }}">
                                            Migrate with AI
                                        </button>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer border-secondary">
                <button type="button"
                        class="btn btn-outline-light btn-sm"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>