{% if detectedFramework is defined and detectedFramework %}
    <div class="framework-info d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="framework-info-icon">
                <svg xmlns="http://www.w3.org/2000/svg"
                    width="22" height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round">
                    <rect x="9" y="2" width="6" height="6" rx="1"/>
                    <rect x="2" y="16" width="6" height="6" rx="1"/>
                    <rect x="16" y="16" width="6" height="6" rx="1"/>
                    <path d="M12 8v4M5 16v-4h14v4"/>
                </svg>
            </div>

            <div>
                <div class="framework-info-label">
                    Detected Framework
                </div>

                <div class="framework-info-name">
                    {{ detectedFramework.framework }}

                    {% if detectedFramework.version %}
                        <span class="framework-info-version">
                            {{ detectedFramework.version }}
                        </span>
                    {% endif %}
                </div>
            </div>
        </div>

        <span class="framework-info-status">
            <i class="bi bi-check-circle me-1"></i>
            Detected
        </span>
    </div>
{% endif %}
