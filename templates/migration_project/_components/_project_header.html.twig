<div class="mb-4">
    <span class="section-label">MIGRATION WORKSPACE</span>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-2">
        <div>
            <h1 class="mb-2">{{ project.name }}</h1>
            <p class="text-secondary mb-0">
                {{ project.sourceFramework }} → {{ project.targetFramework }}
            </p>
        </div>

        <span class="badge rounded-pill text-bg-secondary px-3 py-2">
            {{ project.status.value|replace({'_': ' '})|title }}
        </span>
    </div>
</div>