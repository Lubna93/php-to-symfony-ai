{% extends 'base.html.twig' %}

{% block title %}My Projects | PHP2Symfony AI{% endblock %}

{% block body %}
<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-2">My Projects</h1>
            <p class="text-secondary mb-0">
                Manage your PHP modernization projects.
            </p>
        </div>

        <a href="{{ path('app_project_new') }}" class="btn btn-primary">
            + New Project
        </a>
    </div>

    {% if projects is empty %}
        <div class="text-center py-5">
            <h2 class="h5">No projects yet</h2>
            <p class="text-secondary">
                Create your first migration project to get started.
            </p>
            <a href="{{ path('app_project_new') }}" class="btn btn-primary">
                Create Project
            </a>
        </div>
    {% else %}
        <div class="row g-3">
            {% for project in projects %}
                <div class="col-md-6 col-lg-4">
                    <a href="{{ path('app_project_show', {
                        uid: project.uid
                    }) }}" class="text-decoration-none project-card-link">
                        <div class="feature-card h-100">
                            <h3 class="h5 mb-3">{{ project.name }}</h3>

                            <p class="text-secondary small mb-2">
                                {{ project.sourceFramework }}
                                →
                                {{ project.targetFramework }}
                            </p>

                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small text-secondary">
                                    {{ project.createdAt|date('M d, Y') }}
                                </span>

                                <span class="small">
                                    Open →
                                </span>
                            </div>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}
