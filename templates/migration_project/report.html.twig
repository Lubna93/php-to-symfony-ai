
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>PHP2Symfony AI - Migration Assessment Report</title>

    <style>
        @page {
            size: A4;
            margin: 15mm 15mm;
        }

        /* General */
        body {
            font-family: "DejaVu Sans", sans-serif;
            font-size: 10px;
            line-height: 1.35;
            color: #293241;
        }

        h1, h2, h3 {
            color: #293241;
        }

        h1 {
            font-size: 21px;
            margin: 0 0 5px;
        }

        h2 {
            font-size: 13px;
            margin: 16px 0 8px;
            padding-bottom: 5px;
            border-bottom: 1px solid #ffaa91;
        }

        h3 {
            font-size: 11px;
            margin: 12px 0 6px;
        }

        p {
            margin: 4px 0;
        }

        .subtitle {
            color: #777;
            font-size: 9px;
        }

        .header {
            margin-bottom: 16px;
        }

        .brand {
            color: #e88e76;
            font-size: 11px;
            font-weight: bold;
            margin-bottom: 6px;
        }

        /* Sections */
        .section {
            margin-bottom: 12px;
        }

        /* General Tables */
        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background-color: #f1f3f5;
            text-align: left;
            font-weight: bold;
        }

        th, td {
            padding: 6px 8px;
            border-bottom: 1px solid #e5e7eb;
            vertical-align: top;
        }

        /* 1. Project Overview */
        .overview-table td {
            padding: 5px 8px;
        }

        .overview-table td:first-child {
            width: 35%;
            font-weight: bold;
        }

        /* 2. Codebase Statistics */
        .stats-table {
            margin-top: 6px;
        }

        .stats-table td {
            width: 33.33%;
            padding: 7px 6px;
            text-align: center;
            border: 1px solid #e5e7eb;
        }

        .stat-value {
            font-size: 16px;
            font-weight: bold;
            color: #293241;
        }

        .stat-label {
            font-size: 8px;
            color: #777;
            margin-top: 2px;
        }

        /* 3. Migration Priorities */
        .priority-table th,
        .priority-table td {
            padding: 5px 8px;
            font-size: 9px;
        }

        .priority-high {
            color: #dc3545;
            font-weight: bold;
        }

        .priority-medium {
            color: #d97706;
            font-weight: bold;
        }

        .priority-low {
            color: #198754;
            font-weight: bold;
        }

        /* 4. AI Migration Plan */
        .migration-plan {
            font-size: 10px;
            line-height: 1.45;
        }

        .migration-plan h1 {
            font-size: 16px;
            margin: 14px 0 7px;
        }

        .migration-plan h2 {
            font-size: 13px;
            margin: 16px 0 8px;
            padding-bottom: 4px;
        }

        .migration-plan h3 {
            font-size: 11px;
            margin: 12px 0 6px;
        }

        .migration-plan p {
            margin: 5px 0;
        }

        .migration-plan ul,
        .migration-plan ol {
            margin: 6px 0;
            padding-left: 20px;
        }

        .migration-plan li {
            margin-bottom: 3px;
        }

        .migration-plan pre {
            background-color: #f5f5f5;
            padding: 8px;
            font-size: 9px;
            line-height: 1.3;
            white-space: pre-wrap;
            overflow-wrap: break-word;
        }

        .migration-plan code {
            font-family: monospace;
            font-size: 9px;
        }

        .migration-plan table {
            font-size: 9px;
            margin: 8px 0;
        }

        .migration-plan table th,
        .migration-plan table td {
            padding: 4px 6px;
        }

        /* 5. File Analysis */
        .file-analysis-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            font-size: 8px;
            line-height: 1.15;
        }

        .file-analysis-table th,
        .file-analysis-table td {
            padding: 3px 4px;
            border-bottom: 1px solid #e5e7eb;
            vertical-align: middle;
            overflow-wrap: break-word;
        }

        .file-analysis-table th {
            background-color: #f1f3f5;
            font-size: 8px;
            font-weight: bold;
        }

        .file-analysis-table thead {
            display: table-header-group;
        }

        .file-analysis-table tr {
            page-break-inside: avoid;
        }

        .file-analysis-table tbody tr:nth-child(even) {
            background-color: #fafafa;
        }

        .file-analysis-table .file-path {
            width: 45%;
            overflow-wrap: anywhere;
        }

        .file-analysis-table .number {
            text-align: center;
        }

        .file-analysis-table .priority {
            text-align: center;
            font-weight: bold;
        }

        .page-break {
            page-break-before: always;
        }

        /* Footer */
        .footer-note {
            margin-top: 18px;
            padding-top: 10px;
            border-top: 1px solid #e5e7eb;
            font-size: 8px;
            line-height: 1.4;
            color: #777;
        }
    </style>
</head>

<body>

    {# Report Header #}

    <div class="header">
        <div class="brand">PHP2Symfony AI</div>

        <h1>Migration Assessment Report</h1>

        <p class="subtitle">
            Generated on {{ generatedAt|date('F d, Y - H:i') }}
        </p>
    </div>

    {# 1. Project Overview #}

    <div class="section">
        <h2>1. Project Overview</h2>

        <table class="overview-table">
            <tbody>
                <tr>
                    <td>Project Name</td>
                    <td>{{ project.name }}</td>
                </tr>
                <tr>
                    <td>Source Framework</td>
                    <td>{{ project.sourceFramework }}</td>
                </tr>
                <tr>
                    <td>Detected Framework</td>
                    <td>
                        {{ detectedFramework.framework|default('Not detected') }}
                        {% if detectedFramework.version is defined and detectedFramework.version %}
                            ({{ detectedFramework.version }})
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <td>Target Framework</td>
                    <td>{{ project.targetFramework }}</td>
                </tr>
                <tr>
                    <td>Analysis Date</td>
                    <td>{{ generatedAt|date('Y-m-d') }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    {# 2. Codebase Statistics #}

    <div class="section">
        <h2>2. Codebase Statistics</h2>

        <table class="stats-table">
            <tbody>
                <tr>
                    <td>
                        <div class="stat-value">{{ analysis.totalFiles }}</div>
                        <div class="stat-label">PHP Files</div>
                    </td>
                    <td>
                        <div class="stat-value">{{ totalLines }}</div>
                        <div class="stat-label">Lines of Code</div>
                    </td>
                    <td>
                        <div class="stat-value">{{ analysis.totalClasses }}</div>
                        <div class="stat-label">Classes</div>
                    </td>
                </tr>

                <tr>
                    <td>
                        <div class="stat-value">{{ analysis.totalFunctions }}</div>
                        <div class="stat-label">Functions / Methods</div>
                    </td>
                    <td>
                        <div class="stat-value">{{ analysis.totalDatabaseCalls }}</div>
                        <div class="stat-label">Database Calls</div>
                    </td>
                    <td>
                        <div class="stat-value">{{ analysis.totalLegacyCalls }}</div>
                        <div class="stat-label">Legacy Calls</div>
                    </td>
                </tr>

                <tr>
                    <td>
                        <div class="stat-value">{{ analysis.totalSqlOperations }}</div>
                        <div class="stat-label">SQL Operations</div>
                    </td>
                    <td>
                        <div class="stat-value">{{ priorities.High }}</div>
                        <div class="stat-label">High Priority Files</div>
                    </td>
                    <td>
                        <div class="stat-value">{{ priorities.Medium }}</div>
                        <div class="stat-label">Medium Priority Files</div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    {# 3. Migration Priorities #}

    <div class="section">
        <h2>3. Migration Priorities</h2>

        <table class="priority-table">
            <thead>
                <tr>
                    <th>Priority</th>
                    <th>Files</th>
                    <th>Description</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td class="priority-high">High</td>
                    <td>{{ priorities.High }}</td>
                    <td>Files requiring closer migration attention.</td>
                </tr>

                <tr>
                    <td class="priority-medium">Medium</td>
                    <td>{{ priorities.Medium }}</td>
                    <td>Files with moderate migration complexity.</td>
                </tr>

                <tr>
                    <td class="priority-low">Low</td>
                    <td>{{ priorities.Low }}</td>
                    <td>Files with lower estimated migration complexity.</td>
                </tr>
            </tbody>
        </table>
    </div>

    {# 4. AI Migration Plan #}

    <div class="section">
        <h2>4. AI Migration Plan</h2>

        <div class="migration-plan">
            {{ planHtml|raw }}
        </div>
    </div>

    {# 5. File Analysis - Last Section #}

    <div class="section">
        <h2>5. File Analysis</h2>

        <p class="subtitle">
            Detailed analysis of {{ analysis.totalFiles }} PHP files.
        </p>

        <table class="file-analysis-table">
            <thead>
                <tr>
                    <th style="width: 45%;">File</th>
                    <th style="width: 10%;">Lines</th>
                    <th style="width: 12%;">Classes</th>
                    <th style="width: 12%;">Functions</th>
                    <th style="width: 21%;">Priority</th>
                </tr>
            </thead>

            <tbody>
                {% for file in analysis.files %}
                    <tr>
                        <td class="file-path">
                            {{ file.path }}
                        </td>

                        <td class="number">
                            {{ file.lines }}
                        </td>

                        <td class="number">
                            {{ file.classes|length }}
                        </td>

                        <td class="number">
                            {{ file.functions|length }}
                        </td>

                        <td class="priority">
                            {% if file.priority == 'High' %}
                                <span class="priority-high">High</span>
                            {% elseif file.priority == 'Medium' %}
                                <span class="priority-medium">Medium</span>
                            {% else %}
                                <span class="priority-low">Low</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">
                            No PHP files found.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="footer-note">
        This report was generated by PHP2Symfony AI.
        AI-generated recommendations should be reviewed before implementation.
    </div>

</body>
</html>
