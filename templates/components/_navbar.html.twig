<nav class="navbar navbar-expand-lg app-navbar">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">
            <span class="brand-icon">&lt;/&gt;</span>
            PHP2Symfony <span class="brand-accent">AI</span>
        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNavbar"
            aria-controls="mainNavbar"
            aria-expanded="false"
            aria-label="Toggle navigation"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_home') }}#how-it-works">
                        How it works
                    </a>
                </li>

                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_project_index') }}">
                            My Projects
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_project_new') }}">
                            New Project
                        </a>
                    </li>

                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('admin') }}">
                                Admin
                            </a>
                        </li>
                    {% endif %}
                    
                    <li class="nav-item">
                        <span class="nav-link user-name">
                            {{ app.user.username }}
                        </span>
                    </li>

                    <li class="nav-item">
                        <form action="{{ path('app_logout') }}" method="post" class="m-0">
                            <input type="hidden"
                                   name="_csrf_token"
                                   value="{{ csrf_token('logout') }}">

                            <button type="submit" class="btn btn-outline-secondary btn-sm">
                                Logout
                            </button>
                        </form>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a href="{{ path('connect_github') }}"
                           class="btn btn-primary btn-sm">
                            Continue with GitHub
                        </a>
                    </li>

                    {% if app.environment == 'dev' %}
                        <li class="nav-item">
                            <form action="{{ path('app_demo_login') }}" method="post" class="m-0">
                                <input type="hidden"
                                       name="_token"
                                       value="{{ csrf_token('demo_login') }}">

                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                    Try Demo
                                </button>
                            </form>
                        </li>
                    {% endif %}
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
